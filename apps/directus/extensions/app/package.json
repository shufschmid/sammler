{
  "name": "app",
  "description": "All server-side logic of this application, as a single Directus extension bundle.",
  "icon": "extension",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-bundle"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "endpoint",
        "name": "vermittlungsbuero-draft",
        "source": "src/endpoints/vermittlungsbuero-draft/index.ts"
      },
      {
        "type": "hook",
        "name": "offers-normalize",
        "source": "src/hooks/offers-normalize/index.ts"
      },
      {
        "type": "endpoint",
        "name": "offers-collect",
        "source": "src/endpoints/offers-collect/index.ts"
      },
      {
        "type": "endpoint",
        "name": "wohnungen-collect",
        "source": "src/endpoints/wohnungen-collect/index.ts"
      },
      {
        "type": "endpoint",
        "name": "wohnungen-from-url",
        "source": "src/endpoints/wohnungen-from-url/index.ts"
      },
      {
        "type": "endpoint",
        "name": "wohnungen-draft",
        "source": "src/endpoints/wohnungen-draft/index.ts"
      },
      {
        "type": "hook",
        "name": "wohnungen-normalize",
        "source": "src/hooks/wohnungen-normalize/index.ts"
      },
      {
        "type": "operation",
        "name": "wohnungen-weekly",
        "source": {
          "app": "src/operations/wohnungen-collect/app.ts",
          "api": "src/operations/wohnungen-collect/api.ts"
        }
      }
    ],
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "validate": "directus-extension validate",
    "add": "directus-extension add",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@directus/errors": "^2.1.0",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.28"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "17.1.4",
    "@directus/types": "13.4.0",
    "@types/express": "4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.30",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "vue": "3.5.24"
  }
}
